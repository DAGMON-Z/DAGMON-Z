#!/usr/bin/env python3
"""thm-sync: keeps the TryHackMe stats on the GitHub profile up to date.

TryHackMe blocks programs from reading profiles (a bot checkpoint), but your
own browser is allowed in. So the "THM profile sync" Brave extension (in
extension/) reads your public stats while you have tryhackme.com open, and
sends them here, on this computer only (127.0.0.1, port 27150).

When a number changed, this saves the stats to data/thm.json in the profile
repository and pushes. GitHub then rebuilds the profile within a minute.

Runs as a user service:  systemctl --user status thm-sync
Log:                     journalctl --user -u thm-sync
"""
import json
import os
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

PORT = 27150
REPO = Path(os.environ.get("THM_REPO", Path(__file__).resolve().parents[2]))
DATA = REPO / "data" / "thm.json"

# Only these fields are kept, and only if they are plain numbers or short text
FIELDS = ["username", "level", "rank", "topPercentage", "completedRoomsNumber",
          "badgesNumber", "totalPoints", "leagueTier", "streak"]

lock = threading.Lock()


def log(msg):
    print(msg, flush=True)


def notify(msg):
    subprocess.run(["notify-send", "-a", "TryHackMe", "TryHackMe", msg],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def git(*args):
    return subprocess.run(["git", "-C", str(REPO), *args], capture_output=True, text=True)


def clean(data):
    stats = {}
    for key in FIELDS:
        value = data.get(key)
        if isinstance(value, bool):
            continue
        if isinstance(value, (int, float)) or (isinstance(value, str) and len(value) <= 40):
            stats[key] = value
    return stats


def save_and_push(stats):
    """Save the new stats and push them. Retries if GitHub has newer commits."""
    with lock:
        for attempt in range(3):
            # Start from GitHub's latest version (the CTF bot also commits)
            if git("pull", "-q", "--rebase").returncode != 0:
                git("rebase", "--abort")
                time.sleep(5)
                continue
            cfg = json.loads(DATA.read_text())
            old = {k: v for k, v in cfg.get("stats", {}).items() if k != "synced"}
            if old == stats:
                return "unchanged"
            cfg["stats"] = {**stats, "synced": int(time.time())}
            DATA.write_text(json.dumps(cfg, indent=2) + "\n")
            rooms = stats.get("completedRoomsNumber", "?")
            rank = stats.get("rank", "?")
            git("add", str(DATA))
            git("commit", "-q", "-m", f"thm: {rooms} rooms, rank {rank}")
            if git("push", "-q").returncode == 0:
                log(f"pushed: {rooms} rooms, rank {rank}")
                if old:
                    notify(f"Profile updated: {rooms} rooms, rank #{rank}")
                return "pushed"
            git("reset", "-q", "--hard", "@{u}")  # drop our commit, try again
            time.sleep(5 * (attempt + 1))
        log("push failed 3 times; will try again with the next update")
        return "failed"


class Handler(BaseHTTPRequestHandler):
    def reply(self, code, body):
        data = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_POST(self):
        # Only the browser extension may send stats, not websites
        if not self.headers.get("Origin", "").startswith("chrome-extension://"):
            return self.reply(403, {"ok": False, "error": "only the extension may send"})
        if self.path != "/thm":
            return self.reply(404, {"ok": False})
        length = int(self.headers.get("Content-Length") or 0)
        if not 0 < length <= 200_000:
            return self.reply(400, {"ok": False})
        try:
            body = json.loads(self.rfile.read(length))
            data = body["data"]
            assert body.get("status") == "success" and isinstance(data, dict)
        except Exception:
            return self.reply(400, {"ok": False, "error": "not a TryHackMe profile"})
        want = json.loads(DATA.read_text()).get("user", "")
        if str(data.get("username", "")).lower() != want.lower():
            return self.reply(400, {"ok": False, "error": f"not {want}'s profile"})
        stats = clean(data)
        threading.Thread(target=save_and_push, args=(stats,), daemon=True).start()
        self.reply(202, {"ok": True})

    def do_GET(self):
        self.reply(200, {"ok": True, "repo": str(REPO)})

    def log_message(self, *args):
        pass


if __name__ == "__main__":
    log(f"thm-sync: listening on 127.0.0.1:{PORT}, repo {REPO}")
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
